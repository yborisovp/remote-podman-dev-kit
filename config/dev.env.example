# First setting to edit: SSH alias or user@host for the dedicated Linux project account.
PODMAN_HOST=podman-dev
ROOT_HOST=
SSH_PORT=
SSH_KEY=
PROJECT_NAME=myapp
REMOTE_BASE=.cache/remote-podman-dev
# Optional project root, relative to this kit or absolute. Empty: kit directory, then parent.
PROJECT_DIR=
COMPOSE_FILE=
COMPOSE_OVERRIDE=
REMOTE_PORT_OFFSET=10000
REQUIRED_ENDPOINTS_FILE=config/required-endpoints.conf

